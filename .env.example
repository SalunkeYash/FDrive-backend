# Shared local defaults — copy to apps/api/.env (and optionally apps/web/.env)
# Never commit real secrets.

# --- App ---
ENVIRONMENT=local
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# --- Postgres ---
DATABASE_URL=postgresql+psycopg://fdrive:fdrive@localhost:5432/fdrive

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- S3 (MinIO locally) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=fdrive
S3_REGION=us-east-1
S3_PRESIGN_EXPIRE_SECONDS=900

# --- Auth ---
JWT_SECRET=dev-only-change-me-fdrive-jwt-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Quota ---
DEFAULT_BYTES_LIMIT=5368709120

# --- Trash ---
TRASH_RETENTION_DAYS=30

# --- SQS (ElasticMQ locally) ---
SQS_ENDPOINT_URL=http://localhost:9324
SQS_QUEUE_URL=http://localhost:9324/queue/fdrive-jobs
